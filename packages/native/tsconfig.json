{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "vue": ["./node_modules/nativescript-vue"] },
    "noEmit": true
  },
  "vueCompilerOptions": { "target": 3, "lib": "nativescript-vue" },
  "include": ["src"]
}
