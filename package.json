{
  "name": "@syntrofic/ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Syntrofic UI components for Vue 3",
  "type": "module",
  "files": [
    "dist",
    "src",
    "site/template-catalog.mjs",
    "site/guides",
    "site/*TemplateDemo.vue",
    "site/*Template.vue",
    "site/Demo*.vue",
    "preview/assets/delivery-area.png",
    "LICENSES",
    "catalog",
    "scripts/platform"
  ],
  "bin": {
    "syntrofic": "./scripts/platform/cli.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./vite": {
      "types": "./scripts/platform/vite.d.mts",
      "import": "./scripts/platform/vite.mjs"
    },
    "./vite/client": {
      "types": "./scripts/platform/vite-client.d.ts"
    },
    "./postcss": {
      "types": "./scripts/platform/postcss.d.mts",
      "import": "./scripts/platform/postcss.mjs"
    },
    "./variants": {
      "types": "./dist/platform/variants.d.ts",
      "import": "./dist/variants.js"
    },
    "./rich-text-editor": {
      "types": "./dist/components/SRichTextEditor.vue.d.ts",
      "import": "./dist/rich-text-editor.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./code-block": {
      "types": "./dist/components/SCodeBlock.vue.d.ts",
      "import": "./dist/code-block.js"
    },
    "./number-stepper": {
      "types": "./dist/components/SNumberStepper.vue.d.ts",
      "import": "./dist/number-stepper.js"
    },
    "./calendar-year-picker": {
      "types": "./dist/components/SCalendarYearPicker.vue.d.ts",
      "import": "./dist/calendar-year-picker.js"
    },
    "./date-input-group": {
      "types": "./dist/components/SDateInputGroup.vue.d.ts",
      "import": "./dist/date-input-group.js"
    },
    "./empty-state": {
      "types": "./dist/components/SEmptyState.vue.d.ts",
      "import": "./dist/empty-state.js"
    },
    "./header": {
      "types": "./dist/components/SHeader.vue.d.ts",
      "import": "./dist/header.js"
    },
    "./list-box-item": {
      "types": "./dist/components/SListBoxItem.vue.d.ts",
      "import": "./dist/list-box-item.js"
    },
    "./list-box-section": {
      "types": "./dist/components/SListBoxSection.vue.d.ts",
      "import": "./dist/list-box-section.js"
    },
    "./menu": {
      "types": "./dist/components/SMenu.vue.d.ts",
      "import": "./dist/menu.js"
    },
    "./menu-item": {
      "types": "./dist/components/SMenuItem.vue.d.ts",
      "import": "./dist/menu-item.js"
    },
    "./menu-section": {
      "types": "./dist/components/SMenuSection.vue.d.ts",
      "import": "./dist/menu-section.js"
    },
    "./radio": {
      "types": "./dist/components/SRadio.vue.d.ts",
      "import": "./dist/radio.js"
    },
    "./switch-group": {
      "types": "./dist/components/SSwitchGroup.vue.d.ts",
      "import": "./dist/switch-group.js"
    },
    "./tag": {
      "types": "./dist/components/STag.vue.d.ts",
      "import": "./dist/tag.js"
    },
    "./color-input-group": {
      "types": "./dist/components/SColorInputGroup.vue.d.ts",
      "import": "./dist/color-input-group.js"
    },
    "./rac": {
      "types": "./dist/rac/index.d.ts",
      "import": "./dist/rac.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config site/vite.config.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build --mode library && vite build --mode theme-sheet && vue-tsc -p tsconfig.lib.json",
    "build:preview": "vite build",
    "build:site": "vite build --config site/vite.config.mjs",
    "preview:site": "vite preview --config site/vite.config.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "check:site-stability": "playwright test --config playwright.site-stability.config.ts",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:nuxt": "node scripts/check-nuxt.mjs",
    "check:native": "node scripts/check-native.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.19.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-sankey": "0.12.5",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "emojibase-data": "18.0.0",
    "lightningcss": "1.33.0",
    "maplibre-gl": "6.19.0",
    "postcss-selector-parser": "7.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fontsource-variable/arimo": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "3.6.9",
    "@tanstack/vue-virtual": "^3.13.52",
    "@tiptap/core": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "@tiptap/vue-3": "3.34.0",
    "d3-sankey": "0.12.3",
    "embla-carousel": "^8.6.0",
    "lowlight": "3.3.0",
    "markdown-it": "15.0.3",
    "qrcode-generator": "2.0.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "3.7.1",
    "three": "0.187.0",
    "vega": "6.4.0",
    "vega-embed": "7.4.0",
    "vega-lite": "6.5.0"
  }
}
